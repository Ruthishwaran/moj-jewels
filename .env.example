# Razorpay API Credentials (Configure in .env locally & Vercel Environment Variables in production)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Public Key ID exposed to Vite frontend (NEVER prefix RAZORPAY_KEY_SECRET with VITE_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
